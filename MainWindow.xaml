<Window x:Class="KfuPet_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KfuPet_Tool"
        xmlns:models="clr-namespace:KfuPet_Tool.Models"
        xmlns:helpers="clr-namespace:KfuPet_Tool.Helpers"
        mc:Ignorable="d"
        Title="KfuPet Tool" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:InvertBoolConverter x:Key="invertBoolConverter"/>
        <helpers:NullToVisibilityConverter x:Key="nullToVisibility"/>
        <HierarchicalDataTemplate DataType="{x:Type models:BoneInfo}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BoneName}" Margin="2,0"/>
                <TextBlock Text=" (" Foreground="Gray" FontSize="11"/>
                <TextBlock Text="{Binding BoneId}" Foreground="Gray" FontSize="11"/>
                <TextBlock Text=")" Foreground="Gray" FontSize="11"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="保存日志(_S)" Command="{Binding SaveLogCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="刷新骨骼树(_R)" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="清除日志(_C)" Command="{Binding ClearLogCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于(_A)" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="管道：" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePipes}"
                          SelectedItem="{Binding SelectedPipe}"
                          Margin="5,0" Padding="3"
                          IsEnabled="{Binding IsConnected, Converter={StaticResource invertBoolConverter}}"/>
                <Button Grid.Column="2" Content="扫描" Command="{Binding ScanPipesCommand}" 
                        Padding="10,3" Margin="5,0"/>
                <Button Grid.Column="3" Content="连接" Command="{Binding ConnectCommand}" 
                        IsEnabled="{Binding IsLoading, Converter={StaticResource invertBoolConverter}}"
                        Padding="15,3" Margin="5,0"/>
                <Button Grid.Column="4" Content="断开" Command="{Binding DisconnectCommand}" 
                        IsEnabled="{Binding IsConnected}"
                        Padding="15,3" Margin="5,0"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#666"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,2"/>
                    <CheckBox Content="调试线框" IsChecked="{Binding IsDebugSkeleton}" 
                              IsEnabled="{Binding IsConnected}"
                              VerticalAlignment="Center" Margin="5,0"
                              Checked="DebugSkeleton_Changed" Unchecked="DebugSkeleton_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="骨骼结构" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshCommand}" 
                                IsEnabled="{Binding IsConnected}"
                                Padding="8,2" FontSize="11"/>
                    </Grid>
                </Border>

                <TreeView Grid.Row="1" x:Name="BoneTreeView" ItemsSource="{Binding RootBones}"
                          SelectedItemChanged="BoneTreeView_SelectedItemChanged"
                          BorderThickness="0">
                </TreeView>

                <GridSplitter Grid.Row="2" Height="4" Background="#E0E0E0" HorizontalAlignment="Stretch"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志输出" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="保存" 
                                        Command="{Binding DataContext.SaveLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="6,2" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="清除" 
                                        Command="{Binding DataContext.ClearLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="6,2" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogMessages}" 
                             BorderThickness="0" Background="White"
                             FontSize="11" FontFamily="Consolas"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" Background="#E0E0E0" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="骨骼预览" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#1E1E1E" Margin="0">
                    <Viewbox Stretch="Uniform" Margin="10">
                        <Canvas x:Name="PreviewCanvas" Width="400" Height="400" Background="#2D2D30">
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="1" Background="#E0E0E0" HorizontalAlignment="Stretch"/>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,0,10,10">
                    <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,6,0,6" Margin="0,0,0,8">
                        <TextBlock Text="属性面板" FontWeight="Bold"/>
                    </Border>

                    <StackPanel DataContext="{Binding SelectedBone}">
                        <TextBlock Text="骨骼信息" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="骨骼ID：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BoneId}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="名称：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BoneName}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="父骨骼：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParentBoneId, FallbackValue=无}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="位置" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="X：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PositionDeltaX, UpdateSourceTrigger=LostFocus}"
                                     Padding="3" Margin="0,2" KeyDown="PositionInput_KeyDown"
                                     ToolTip="相对初始位置的累计修改量"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PositionDeltaY, UpdateSourceTrigger=LostFocus}"
                                     Padding="3" Margin="0,2" KeyDown="PositionInput_KeyDown"
                                     ToolTip="相对初始位置的累计修改量"/>
                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="应用" 
                                    Command="{Binding DataContext.SetPositionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="10,3" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="旋转" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="角度：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBox Grid.Column="1" Text="{Binding RotationDelta, UpdateSourceTrigger=LostFocus}"
                                     Padding="3" Margin="0,2" KeyDown="RotationInput_KeyDown"
                                     ToolTip="相对初始角度的累计修改量"/>
                            <Button Grid.Column="2" Content="应用" 
                                    Command="{Binding DataContext.SetRotationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="10,3" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Expander IsExpanded="False" Margin="0,8,0,4">
                            <Expander.Header>
                                <TextBlock Text="骨骼缩放（测试功能，后期可能会抛弃）" FontWeight="Bold" Foreground="#999" FontSize="12"/>
                            </Expander.Header>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ScaleX：" VerticalAlignment="Center" Foreground="#666"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ScaleDeltaX, UpdateSourceTrigger=LostFocus}"
                                         Padding="3" Margin="0,2" KeyDown="ScaleInput_KeyDown"
                                         ToolTip="相对初始缩放的累计修改量"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ScaleY：" VerticalAlignment="Center" Foreground="#666"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScaleDeltaY, UpdateSourceTrigger=LostFocus}"
                                         Padding="3" Margin="0,2" KeyDown="ScaleInput_KeyDown"
                                         ToolTip="相对初始缩放的累计修改量"/>
                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="应用" 
                                        Command="{Binding DataContext.SetScaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,3" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Expander>

                        <TextBlock Text="状态" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Text="激活：" VerticalAlignment="Center" Foreground="#666"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsActive}" 
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Checked="IsActive_Checked" Unchecked="IsActive_Unchecked"/>
                        </Grid>

                        <TextBlock Text="世界坐标" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="WorldX：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorldX, StringFormat=F2}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="WorldY：" VerticalAlignment="Center" Foreground="#666"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WorldY, StringFormat=F2}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="操作" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="恢复骨骼" Command="{Binding DataContext.ResetBoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="10,3" Margin="0,0,5,0" ToolTip="恢复选中骨骼到连接时的初始状态"/>
                            <Button Content="恢复全部" Command="{Binding DataContext.ResetAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="10,3" Background="#FFF0F0" Foreground="Red" ToolTip="恢复所有骨骼到连接时的初始状态"/>
                        </StackPanel>

                        <TextBlock Text="图片挂载" FontWeight="Bold" Foreground="#333" Margin="0,8,0,4"/>
                        <ListBox ItemsSource="{Binding Attachments}" 
                                 SelectedItem="{Binding DataContext.SelectedAttachment, RelativeSource={RelativeSource AncestorType=Window}}"
                                 MinHeight="60" MaxHeight="150" Margin="0,0,0,8"
                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                 Background="White">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="BorderBrush" Value="#90CAF9"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AttachmentInfo}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Visible}" 
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Checked="AttachmentVisible_Changed" 
                                                  Unchecked="AttachmentVisible_Changed"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontSize="12"/>
                                        <Button Grid.Column="2" Content="✕" 
                                                Width="24" Height="24" FontSize="12"
                                                Click="RemoveAttachment_Click"
                                                Background="#FFF0F0" Foreground="#D32F2F"
                                                BorderBrush="#FFCDD2" BorderThickness="1"
                                                Cursor="Hand" ToolTip="移除图片">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#FFF0F0"/>
                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                    <Setter Property="BorderBrush" Value="#FFCDD2"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFCDD2"/>
                                                            <Setter Property="Foreground" Value="#B71C1C"/>
                                                            <Setter Property="BorderBrush" Value="#E57373"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel DataContext="{Binding DataContext.SelectedAttachment, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding Converter={StaticResource nullToVisibility}}">
                            <TextBlock Text="图片缩放" FontWeight="Bold" Foreground="#333" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ScaleX：" VerticalAlignment="Center" Foreground="#666"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ScaleDeltaX, UpdateSourceTrigger=LostFocus}"
                                         Padding="3" Margin="0,2" KeyDown="AttachmentScaleInput_KeyDown"
                                         ToolTip="相对图片初始缩放的累计修改量"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ScaleY：" VerticalAlignment="Center" Foreground="#666"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScaleDeltaY, UpdateSourceTrigger=LostFocus}"
                                         Padding="3" Margin="0,2" KeyDown="AttachmentScaleInput_KeyDown"
                                         ToolTip="相对图片初始缩放的累计修改量"/>
                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="应用" 
                                        Command="{Binding DataContext.SetAttachmentScaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Padding="10,3" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Button Content="挂载图片" 
                                Command="{Binding DataContext.UploadAndAddAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Padding="10,3" Margin="0,0,0,8" 
                                IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
